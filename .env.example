# Copy to .env and fill in real credentials. Never commit .env.

# Supabase (PostgreSQL + Storage bucket)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=screenshots

# DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Reviewer identity (unique short name per team member)
REVIEWER_NAME=member-1

# Verifier limits
VERIFY_TIMEOUT_MS=15000
SCREENSHOT_JPEG_QUALITY=60

# Auto-Submit Target Portal (ganti 1 baris SUBMIT_TARGET_URL saat hari perlombaan)
# Default Docker: http://mock-target:8001 | Default lokal: http://127.0.0.1:8001
SUBMIT_TARGET_URL=http://127.0.0.1:8001
SUBMIT_LINKS_SELECTOR=textarea[name="links"]
SUBMIT_REPORTER_SELECTOR=input[name="reporter"]
SUBMIT_BUTTON_SELECTOR=button[type="submit"]
SUBMIT_SUCCESS_SELECTOR=[data-submit-status="ok"]
